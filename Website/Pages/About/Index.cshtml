@page "/about"
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "About Bjørn Sødal — computer engineer (BSc, University of Agder) and IoT master's student working with embedded systems, machine vision, DSP and autonomous robotics.";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow reveal">About</p>
        <h1 class="reveal">Bjørn Sødal</h1>
    </div>
</section>

<section class="section section--flush-top">
    <div class="container about">
        <div class="about__portrait reveal">
            <div class="media-placeholder media-placeholder--portrait" data-label="Portrait">
                <!-- Replace with: <img src="/img/portrait.jpg" alt="Bjørn Sødal" /> -->
            </div>
        </div>

        <div class="about__text prose reveal">
            <p class="lead">I&rsquo;m an engineer who likes machines that leave the desk &mdash; things that float, dive and fly, and the software that lets them see and decide for themselves.</p>
            <p>I hold a bachelor&rsquo;s degree in computer engineering from the University of Agder, where I specialised in software development and took extra courses from electrical engineering and mechatronics in digital signal processing and machine vision.</p>
            <p>I&rsquo;m now taking a master&rsquo;s in the Internet of Things at UiA, which I&rsquo;ll continue part-time from 2027 alongside full-time work &mdash; bringing new research in sensors, embedded AI and autonomy straight into practice.</p>
            <p>In <a href="https://github.com/SeaBotics" rel="noopener">SeaBotics</a>, UiA&rsquo;s student organisation for autonomous vessels, I&rsquo;m responsible for machine vision and system health on Hugr Optimus.</p>

            <h2 class="h-small">Focus areas</h2>
            <ul class="pill-list">
                <li>Computer &amp; machine vision</li>
                <li>Digital signal processing</li>
                <li>Embedded programming</li>
                <li>Autonomous robotics</li>
                <li>Internet of Things</li>
                <li>UAV, ROV &amp; ASV development</li>
            </ul>

            <h2 class="h-small">Toolbox</h2>
            <ul class="pill-list">
                <li>C</li>
                <li>C++</li>
                <li>Python</li>
                <li>ROS 2</li>
                <li>VHDL / FPGA</li>
                <li>ARM &amp; x86 assembly</li>
                <li>Docker &amp; CI/CD</li>
            </ul>

            <h2 class="h-small">Certificates &amp; languages</h2>
            <ul class="pill-list">
                <li>Drone operator A1/A3</li>
                <li>VHF radio operator</li>
                <li>Norwegian (native)</li>
                <li>English (fluent)</li>
                <li>German (basic)</li>
            </ul>
        </div>
    </div>
</section>

<section class="section section--tinted">
    <div class="container container--narrow">
        <header class="section-head reveal">
            <p class="eyebrow">Path so far</p>
            <h2>Experience &amp; education</h2>
        </header>

        <ol class="timeline">
            <li class="timeline__item reveal">
                <p class="timeline__when">2026 &ndash; present</p>
                <h3>Software developer &mdash; SeaBotics</h3>
                <p class="timeline__where">Volunteer, University of Agder student organisation</p>
                <p class="timeline__detail">Responsible for machine vision and system health on the autonomous surface vessel Hugr Optimus. Also contributing to teleoperation, embedded programming, edge AI, telemetry, 5G connectivity, CI/CD and systems engineering.</p>
            </li>
            <li class="timeline__item reveal">
                <p class="timeline__when">2026 &ndash; present &middot; part-time from 2027</p>
                <h3>Master of Science &mdash; Internet of Things</h3>
                <p class="timeline__where">University of Agder, Grimstad</p>
                <p class="timeline__detail">Sensor technologies such as radar, LiDAR, cameras, stereo vision and radio, and how to program and optimise them with embedded C/C++ and VHDL for FPGAs. Extra courses in mechatronics and electrical engineering towards autonomous robotics and embedded AI.</p>
            </li>
            <li class="timeline__item reveal">
                <p class="timeline__when">2023 &ndash; 2026</p>
                <h3>Bachelor of Science &mdash; Computer Engineering</h3>
                <p class="timeline__where">University of Agder, Grimstad</p>
                <p class="timeline__detail">Specialisation in software development, with extra courses in digital signal processing and machine vision from electrical engineering and mechatronics.</p>
            </li>
        </ol>
    </div>
</section>

<section class="section quote-section">
    <div class="container container--narrow">
        <figure class="quote reveal">
            <blockquote>
                <p>&ldquo;At <em>no</em> time are we ever in such complete <em>possession</em> of a journey, down to its last nook and cranny, as when we are busy with <em>preparations</em> for it.&rdquo;</p>
            </blockquote>
            <figcaption>Yukio Mishima</figcaption>
        </figure>
    </div>
</section>

