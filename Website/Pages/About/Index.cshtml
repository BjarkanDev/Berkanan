@page "/about"
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "About Bjørn Sødal — computer engineer and IoT master's student working with embedded systems, computer vision, DSP and autonomous vessels.";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow reveal">About</p>
        <h1 class="reveal">Bjørn Sødal</h1>
    </div>
</section>

<section class="section section--flush-top">
    <div class="container about">
        <div class="about__portrait reveal">
            <div class="media-placeholder media-placeholder--portrait" data-label="Portrait">
                <!-- Replace with: <img src="/img/portrait.jpg" alt="Bjørn Sødal" /> -->
            </div>
        </div>

        <div class="about__text prose reveal">
            <p class="lead">I&rsquo;m an engineer who likes machines that leave the desk &mdash; things that float, dive and fly, and the software that lets them see and decide for themselves.</p>
            <p>My background is in computer engineering, and I&rsquo;m now taking a master&rsquo;s degree focused on the Internet of Things. Most of my time goes into machine and computer vision, digital signal processing and embedded programming, and into putting those together in UAV, ROV and ASV systems.</p>
            <p>Outside coursework I&rsquo;m involved in <a href="https://github.com/SeaBotics" rel="noopener">SeaBotics</a>, the University of Agder&rsquo;s student organisation building autonomous vessels for competition.</p>

            <h2 class="h-small">Focus areas</h2>
            <ul class="pill-list">
                <li>Computer &amp; machine vision</li>
                <li>Digital signal processing</li>
                <li>Embedded programming</li>
                <li>Internet of Things</li>
                <li>UAV, ROV &amp; ASV development</li>
            </ul>
        </div>
    </div>
</section>

<section class="section section--tinted">
    <div class="container container--narrow">
        <header class="section-head reveal">
            <p class="eyebrow">Path so far</p>
            <h2>Education</h2>
        </header>

        <ol class="timeline">
            <li class="timeline__item reveal">
                <p class="timeline__when">Ongoing</p>
                <h3>Master of Science &mdash; Internet of Things</h3>
                <p class="timeline__where"><!-- TODO: university and expected year -->&nbsp;</p>
            </li>
            <li class="timeline__item reveal">
                <p class="timeline__when"><!-- TODO: years -->Completed</p>
                <h3>Bachelor of Science &mdash; Computer Engineering</h3>
                <p class="timeline__where">University of Agder, Grimstad</p>
            </li>
        </ol>
    </div>
</section>

<section class="section quote-section">
    <div class="container container--narrow">
        <figure class="quote reveal">
            <blockquote>
                <p>&ldquo;At <em>no</em> time are we ever in such complete <em>possession</em> of a journey, down to its last nook and cranny, as when we are busy with <em>preparations</em> for it.&rdquo;</p>
            </blockquote>
            <figcaption>Yukio Mishima</figcaption>
        </figure>
    </div>
</section>

