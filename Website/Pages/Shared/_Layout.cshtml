@{
    var title = ViewData["Title"] as string;
    var description = ViewData["Description"] as string
        ?? "Bjørn Sødal — engineer working with embedded systems, computer vision, signal processing and autonomous vessels.";
    var pageTitle = string.IsNullOrEmpty(title) || title == "Home" ? "Berkanan — Bjørn Sødal" : $"{title} — Berkanan";
    var path = Context.Request.Path.Value ?? "/";
    var canonical = "https://berkanan.no" + (path == "/" ? "/" : path.TrimEnd('/'));
    string Active(string p) => (p == "/" ? path == "/" : path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "is-active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />

    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem("theme"); } catch (e) { }
            if (t !== "light" && t !== "dark") {
                t = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-theme", t);
            document.documentElement.classList.add("js");
        })();
    </script>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F7F3EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141B2D" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Berkanan" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="https://berkanan.no/img/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="~/fonts/cardo-regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="~/fonts/inter-regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
        <div class="container site-header__inner">
            <a class="brand" href="/" aria-label="Berkanan — home">
                <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="18.5" />
                    <path d="M15 8 V32 M15 8 L25 14 L15 20 L25 26 L15 32" />
                </svg>
                <span class="brand__name">Berkanan</span>
            </a>

            <nav class="site-nav" id="site-nav" aria-label="Main">
                <ul>
                    <li><a class="@Active("/")" href="/">Home</a></li>
                    <li><a class="@Active("/portfolio")" href="/portfolio">Portfolio</a></li>
                    <li><a class="@Active("/about")" href="/about">About</a></li>
                    <li><a href="/about#contact">Contact</a></li>
                </ul>
            </nav>

            <div class="site-header__actions">
                <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme">
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
                </button>
                <button class="icon-btn nav-toggle" type="button" data-nav-toggle aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
                    <span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main id="main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <div class="site-footer__brand">
                <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="18.5" />
                    <path d="M15 8 V32 M15 8 L25 14 L15 20 L25 26 L15 32" />
                </svg>
                <p>Berkanan</p>
            </div>
            <ul class="site-footer__links">
                <li><a href="/portfolio">Portfolio</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="mailto:bjornsodal@gmail.com">Email</a></li>
                <li><a href="https://github.com/BjarkanDev" rel="noopener">GitHub</a></li>
                <li><a href="www.linkedin.com/in/bjørn-sødal" rel="noopener">LinkedIn</a></li>
            </ul>
            <p class="site-footer__copy">&copy; <span data-year>@DateTime.Now.Year</span> Berkanan &middot; Bjørn Sødal</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
