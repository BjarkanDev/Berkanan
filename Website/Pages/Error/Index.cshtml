@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-hero page-hero--full">
    <div class="container container--narrow center">
        <p class="eyebrow">Something went wrong</p>
        <h1>Rough waters</h1>
        <p class="page-hero__lead">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="muted"><small>Request ID: <code>@Model.RequestId</code></small></p>
        }

        <p><a class="btn" href="/">Back to home</a></p>
    </div>
</section>
